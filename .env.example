# ==============================================================================
# Adaptive Learning System — Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini LLM Configuration (Google GenAI)
# ------------------------------------------------------------------------------
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 2. FastAPI Backend Server Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000
JWT_SECRET=cognitive-adaptive-secret-key-2026

# ------------------------------------------------------------------------------
# 3. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# URL pointing to the FastAPI backend API root
VITE_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 4. RAG & Vector Store Configuration (Optional Overrides)
# ------------------------------------------------------------------------------
RAG_EMBEDDING_DEVICE=cpu
RAG_COLLECTION_NAME=programming_knowledge

# ------------------------------------------------------------------------------
# 5. Firebase Authentication Configuration
# ------------------------------------------------------------------------------
# In Vite, client environment variables must start with VITE_
VITE_FIREBASE_API_KEY="your_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id"
