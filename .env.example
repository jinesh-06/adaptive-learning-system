# ==============================================================================
# Adaptive Learning System — Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment Environment Mode
# ------------------------------------------------------------------------------
# Set to 'development', 'test', or 'production'.
# In 'production', strict security checks are enforced at startup:
#   - JWT_SECRET must be at least 32 characters and cannot use default/insecure keys.
#   - Wildcard '*' in ALLOWED_ORIGINS is forbidden.
#   - Insecure development headers (e.g. X-User-Id) are unconditionally rejected.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. FastAPI Backend Server Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

# Cryptographic JWT Secret
# Development: fallback default is permitted
# Production: MUST be a high-entropy secret (min 32 chars), e.g. run `openssl rand -hex 32`
JWT_SECRET=cognitive-adaptive-secret-key-2026

# Production Authorized Administrator Emails (comma-separated)
PRODUCTION_ADMIN_EMAILS=admin@cognitive.edu

# Explicit CORS Allowed Origins (comma-separated list of trusted frontend URLs)
# In production, do NOT use '*' when credentialed requests are enabled.
# Example: https://learning-platform.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=https://adaptive-learning-system-sage.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Server-side Firebase Project Identifier (for ID token issuer & audience verification)
FIREBASE_PROJECT_ID=adaptive-learning-system

# Optional SQLite Database Path override (useful for testing or dedicated volume)
# ADAPTIVE_LEARNING_DB_PATH=/path/to/persistent/adaptive_learning.db

# ------------------------------------------------------------------------------
# 3. Gemini LLM Configuration (Google GenAI)
# ------------------------------------------------------------------------------
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. RAG & Vector Store Configuration (Optional Overrides)
# ------------------------------------------------------------------------------
RAG_EMBEDDING_DEVICE=cpu
RAG_COLLECTION_NAME=programming_knowledge

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Note: Variables prefixed with VITE_ are embedded into the client bundle at build
# time and are visible to end users in browser JavaScript. NEVER store server-only
# private secrets (e.g. JWT_SECRET, service account private keys) in VITE_ variables!

# URL pointing to the FastAPI backend API root
VITE_API_URL=http://localhost:5000

# Client-side Firebase Configuration (Web API keys intended for public client auth)
VITE_FIREBASE_API_KEY="your_firebase_web_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id"

# ------------------------------------------------------------------------------
# 6. Secure Code Sandbox Execution Engine Configuration
# ------------------------------------------------------------------------------
SANDBOX_CONTAINER_RUNTIME=docker
SANDBOX_CONTAINER_IMAGE=adaptive-learning-sandbox:latest
ENVIRONMENT=development
ALLOW_TEST_CONTAINER_MOCK=false
